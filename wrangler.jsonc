{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-city",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
